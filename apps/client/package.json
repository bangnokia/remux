{
  "name": "@telemux/client",
  "version": "0.1.11",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "node ../../scripts/expo-start-no-shortcuts.mjs",
    "web": "expo start --web",
    "ios": "expo start --ios --go",
    "android": "expo start --android --go",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:android:apk": "npm run prebuild:android && cd android && NODE_ENV=production ./gradlew :app:assembleRelease",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.15",
    "@expo/ui": "~56.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@telemux/api-client": "workspace:*",
    "@telemux/protocol": "workspace:*",
    "expo": "^56.0.12",
    "expo-build-properties": "~56.0.19",
    "expo-file-system": "^56.0.8",
    "expo-system-ui": "~56.0.5",
    "ghostty-web": "^0.4.0",
    "lucide-react-native": "^0.511.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.14"
  }
}
