{
  "expo": {
    "name": "Telemux",
    "slug": "telemux",
    "version": "0.1.4",
    "orientation": "portrait",
    "scheme": "telemux",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bangnokia.telemux",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101412"
      },
      "package": "com.bangnokia.telemux",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 5
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "952a65ee-3b29-4d15-b6f1-2584fdf81ad8"
      }
    },
    "owner": "bangnokia"
  }
}
