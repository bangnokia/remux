{
  "name": "telemux",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "pnpm --filter @telemux/server run dev",
    "dev:client": "pnpm --filter @telemux/client run dev",
    "build:android:apk": "pnpm --filter @telemux/client run build:android:apk",
    "build:server:standalone": "node scripts/build-server-cli.mjs",
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.27.7",
    "playwright": "^1.60.0",
    "typescript": "5.8.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
